--- /dev/null
+++ docs/analysis/A040-outputs/modal-full-path1/prepare_allowlist.py
@@ -0,0 +1,67 @@
+"""Stage explicitly authorized immutable files; no model imports or remote calls."""
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+STAGE = ROOT / 'tmp/a040-modal-full-path1/stage'
+OLD = 'docs/analysis/A040-outputs/full-path-resume1/'
+PUBLIC = 'tmp/a040-local-technical/source/tabicl-0dbff3ec8fc68c123c87af77b0ea8b25cd2d23f3/'
+MANIFEST = ROOT / (OLD + 'frozen-inputs/manifest.json')
+EXPECTED = 'b5f7effaa0a9ad427c403dfb2d524b8747c469968bb2cbb86419867911c8cacc'
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    if STAGE.exists() or (HERE / 'allowlist.json').exists():
+        raise FileExistsError('Preserve previous staging; do not overwrite')
+    if digest(MANIFEST) != EXPECTED:
+        raise ValueError('Source manifest identity mismatch')
+    manifest = json.loads(MANIFEST.read_text(encoding='utf-8-sig'))
+    indexed = {r['path']: r for r in manifest['files']}
+    selected = [p for p in indexed if p.startswith(PUBLIC + 'src/')]
+    selected += [p for p in indexed if p in (PUBLIC + 'LICENSE', PUBLIC + 'pyproject.toml')]
+    selected += ['external/starter-kit/' + p for p in (
+        'config.yml', 'make_sandbox.py', 'data/unicef.json', 'data/world_bank.json', 'data/unhcr.json')]
+    selected += ['submissions/2026-09-19-E041/main.py']
+    selected += ['tmp/a040-full-path-local-retry1/' + n + '.json'
+                 for n in ('unicef', 'world_bank', 'unhcr')]
+    selected += ['tmp/a040-local-technical/acquisition/tabicl-classifier-v2-20260212.ckpt']
+    selected += [OLD + p for p in ('adapter.py', 'orchestration.py', 'observer.py',
+                 'schema_entry.py', 'telemetry.py', 'roles.json', 'fixture-manifest.json',
+                 'requirements.lock.txt')]
+    fixture = json.loads((ROOT / (OLD + 'fixture-manifest.json')).read_text())
+    for row in fixture['inputs']:
+        if row['path'] not in selected or indexed[row['path']]['sha256'] != row['sha256']:
+            raise ValueError('Fake input allowlist/manifest disagreement')
+    records = []
+    for name in sorted(set(selected)):
+        source = (ROOT / name).resolve()
+        if ROOT not in source.parents or source.is_symlink():
+            raise ValueError('Path outside authorized workspace')
+        actual = digest(source)
+        if actual != indexed[name]['sha256']:
+            raise ValueError('Frozen bytes changed: ' + name)
+        records.append(dict(path=name, sha256=actual, bytes=source.stat().st_size))
+    if digest(ROOT / (OLD + 'roles.json')) != '0f61e0364bb4c2fb9465dffa18a71a391175afb2b149f4f730588f86ebdc3447':
+        raise ValueError('Original public-position roles changed')
+    with (HERE / 'allowlist.json').open('x', encoding='utf-8') as stream:
+        json.dump(dict(source_manifest_sha256=EXPECTED, remote_root='/work',
+                       files=records, remote_transfer_performed=False), stream, indent=2)
+    for row in records:
+        target = STAGE / row['path']
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(ROOT / row['path'], target)
+        if digest(target) != row['sha256']:
+            raise ValueError('Staging copy differs: ' + row['path'])
+    print(json.dumps(dict(staged_files=len(records), bytes=sum(r['bytes'] for r in records),
+                          scientific_imports=0, remote_transfer=0)))
+
+
+if __name__ == '__main__':
+    main()
