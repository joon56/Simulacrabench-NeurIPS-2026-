  "metadata": {
    "SSUID": {
      "label": "Sample unit identifier. This identifier is created by scrambling together PSU, Sequence #1, Sequence #2, and the Frame Indicator for a case. It may be used in matching sample units from different waves.",
      "dtype": "string"
    },
    "PNUM": {
      "label": "Person number",
      "dtype": "integer"
    },
    "MONTHCODE": {
      "label": "Value of reference month",
      "dtype": "integer"
    },
    "ERESIDENCEID": {
      "label": "This field stores a six-digit identifier for residence addresses, unique within SSUID.",
      "dtype": "string"
    },
    "THHLDSTATUS": {
      "label": "Household status",
      "dtype": "integer"
    },
    "TAGE_EHC": {
      "label": "Monthly age during the reference period.",
      "dtype": "integer"
    },
    "TAGE": {
      "label": "Age as of last birthday",
      "dtype": "integer"
    },
    "ESEX": {
      "label": "Sex of this person",
      "dtype": "integer"
    },
    "ERACE": {
      "label": "What race(s) does ... consider herself/himself to be?",
      "dtype": "integer"
    },
    "EORIGIN": {
      "label": "Is ... of Hispanic, Latino, or Spanish origin?",
      "dtype": "integer"
    },
    "EEDUC": {
      "label": "What is the highest level of school ... completed or the highest degree received by December of (reference year)?",
      "dtype": "integer"
    },
    "EMS": {
      "label": "Is ... currently married, widowed, divorced, separated, or never married?",
      "dtype": "integer"
    },
    "THOSPNIT": {
      "label": "How many nights did ... spend in the hospital?",
      "dtype": "integer"
    },
    "AHOSPNIT": {
      "label": "Status Flag for THOSPNIT",
      "dtype": "integer"
    },
    "AHREASON": {
      "label": "Status Flag for EHREAS_BIR, EHREAS_COR, EHREAS_DT, EHREAS_NST, EHREAS_OS, EHREAS_OTH,",
      "dtype": "integer"
    },
    "EHREAS_DT": {
      "label": "Why was ... in the hospital (for the most recent stay)? (Diagnostic test to determine what was wrong)",
      "dtype": "integer"
    },
    "EHREAS_BIR": {
      "label": "Why was ... in the hospital (for the most recent stay)? (Birth - either to be born, or to give birth, including C-section)",
      "dtype": "integer"
    },
    "EHREAS_OS": {
      "label": "Why was ... in the hospital (for the most recent stay)? (Operation or surgery)",
      "dtype": "integer"
    },
    "EHREAS_NST": {
      "label": "Why was ... in the hospital (for the most recent stay)? (Other treatment or therapy not including surgery)",
      "dtype": "integer"
    },
    "EHREAS_OTH": {
      "label": "Why was ... in the hospital (for the most recent stay)? (Any other reason)",
      "dtype": "integer"
    },
    "EHREAS_COR": {
      "label": "Why was ... in the hospital (for the most recent stay)? (To be treated for Covid-19 (suspected or diagnosed), or complications from Covid-19)",
      "dtype": "integer"
    }
  },
